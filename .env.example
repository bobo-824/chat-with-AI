OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://your-proxy.example.com/v1
OPENAI_MODEL=your-model-name
OPENAI_MODELS=model-a,model-b
HOST=127.0.0.1
PORT=8000
APP_PASSWORD=choose-a-strong-password
RELAY_DEBUG_RESPONSE=0

# Optional security controls. Leave them unset to use the secure defaults.
# SECRET_BACKEND=auto                 # auto | macos-keychain | libsecret | windows-dpapi | file
# ALLOW_KEY_REVEAL=1                  # set 0 to disable reading the saved key back in the UI
# COOKIE_SECURE=auto                  # auto | 1 | 0 (1 when a proxy terminates TLS)
# RELAY_CHECK_RESOLVED_ADDRESS=1      # set 0 to skip resolving relay hostnames before saving
